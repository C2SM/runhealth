# Ignore everything at the top level, then allow what belongs in the repository.
/*
!/.github/
!/.gitignore
!/.pre-commit-config.yaml
!/.python-version
!/LICENSE
!/README.md
!/docs/
!/examples/
!/pyproject.toml
!/src/
!/tests/
!/uv.lock

__pycache__/
*.py[cod]
*.egg-info/

##### Sphinx documentation #####
docs/_build/
